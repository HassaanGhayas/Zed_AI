# Base URL of the Studify backend (no trailing slash). Defaults to http://localhost:8000.
# Set this for production builds, otherwise a console warning is logged.
VITE_API_URL=http://localhost:8000

# Optional cloud sync + Google sign-in via Supabase. Leave both unset to run
# fully local (no sign-in UI is shown). Only the public anon key belongs here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
