# Gemini
GOOGLE_API_KEY=

# YouTube transcript access from cloud IPs (all optional)
# Preferred: proxy
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
YOUTUBE_PROXY=
# Fallback: cookies (Netscape cookies.txt path, or its contents)
YOUTUBE_COOKIES_TXT=
YOUTUBE_COOKIES_CONTENT=

# Supabase (all optional; unset = app runs without accounts/sync/shared cache)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=   # service role key, server-side only
# SUPABASE_JWT_SECRET=    # only needed for legacy HS256 projects

# Optional overrides
# UVICORN_RELOAD=true
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=30
# RATE_LIMIT_FRAME_PER_MINUTE=120
# MAX_AUDIO_BYTES=10485760
